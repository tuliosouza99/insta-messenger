{
  "name": "instagram-messenger-desktop",
  "productName": "Instagram Messenger",
  "version": "0.2.1",
  "private": true,
  "description": "A focused, local desktop window for Instagram messages.",
  "author": "Tulio Souza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuliosouza99/insta-messenger.git"
  },
  "bugs": {
    "url": "https://github.com/tuliosouza99/insta-messenger/issues"
  },
  "homepage": "https://github.com/tuliosouza99/insta-messenger#readme",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.js",
    "test": "node --test test/policy.test.js test/desktop-policy.test.js test/focus.test.js test/preload.test.js test/attachment-viewer.test.js test/live-attachment.test.js test/story-controls.test.js test/unread.test.js test/notifications.test.js",
    "test:desktop": "npm run build && node --test --test-concurrency=1 test/electron.test.js",
    "build:ios": "node scripts/build-ios.js",
    "test:ios": "node scripts/build-ios.js --check && node --test test/ios.test.js test/ios-activity.test.js",
    "check:all": "npm run check && npm run test:desktop",
    "check": "npm run build && npm test",
    "package": "npm run check && node scripts/package.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
